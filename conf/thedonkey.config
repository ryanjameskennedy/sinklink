/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config for thedonkey (mp-bioinfo)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    20 threads and 188 GB RAM, no scheduler, shared with two colleagues. Caps sit
    ~25% below the machine totals because nothing else arbitrates between users.
    Database paths follow the JASEN setup on the same machine.

    Use as follows:
        nextflow run ryanjameskennedy/sinklink -profile thedonkey --input samplesheet.csv \
            --metadata metadata.csv --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'thedonkey'
    config_profile_description = 'Single shared server, local executor, Apptainer'

    schemas_dir                = '/mnt/cache/dbs/vask/schemas'
    kraken_db                  = '/mnt/cache/dbs/kraken2/standard_2025-06'
    gambit_db                  = '/mnt/cache/dbs/gambit_db'
}

workDir = "/media/shortterm/${System.getenv('USER')}/work"

process {
    executor       = 'local'
    resourceLimits = [ cpus: 15, memory: 141.GB, time: 48.h ]

    withName: 'KRAKEN2_KRAKEN2' {
        maxForks = 1
    }
}

executor {
    $local {
        cpus   = 15
        memory = 141.GB
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/mnt/cache/singularity'
    runOptions = '--bind /mnt/cache/dbs'
}
conda.enabled       = false
docker.enabled      = false
singularity.enabled = false

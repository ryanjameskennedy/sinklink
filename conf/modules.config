/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Read preparation
    //
    withName: 'DEACON_FILTER' {
        ext.prefix = { "${meta.id}.host_removed" }
        publishDir = [
            path: { "${params.outdir}/host_removal" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('.json') ? filename :
                filename.endsWith('.fq.gz') && params.save_host_removed_reads ? filename : null
            }
        ]
    }

    withName: 'TRIMMOMATIC' {
        ext.args   = { params.trimmomatic_args }
        publishDir = [
            path: { "${params.outdir}/trimmomatic" },
            mode: params.publish_dir_mode,
            pattern: '*{.summary,_out.log}'
        ]
    }

    withName: 'FILTLONG' {
        ext.args   = { params.filtlong_args }
        ext.prefix = { "${meta.id}.filtlong" }
        publishDir = [
            path: { "${params.outdir}/filtlong" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'FASTQC' {
        ext.args = '--quiet'
    }

    withName: 'NANOPLOT' {
        ext.args   = { "--prefix ${meta.id}_ --tsv_stats" }
        publishDir = [
            path: { "${params.outdir}/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Assembly
    //
    withName: 'SKESA' {
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.fa'
        ]
    }

    withName: 'FLYE' {
        ext.args   = { meta.genome_size ? "--genome-size ${meta.genome_size} --asm-coverage 50" : '' }
        publishDir = [
            path: { "${params.outdir}/assembly/flye" },
            mode: params.publish_dir_mode,
            pattern: '*.{txt,log,gfa.gz}'
        ]
    }

    withName: 'GUNZIP_FLYE' {
        ext.prefix = { "${meta.id}.flye" }
        publishDir = [ enabled: false ]
    }

    withName: 'MEDAKA' {
        ext.args   = '--bacteria'
        publishDir = [ enabled: false ]
    }

    withName: 'GUNZIP_ASSEMBLY' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.fa'
        ]
    }

    //
    // Assembly QC
    //
    withName: 'QUAST' {
        ext.prefix = { "${meta.id}.quast" }
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: params.publish_dir_mode,
            pattern: '*.quast'
        ]
    }

    withName: 'MASH_DIST' {
        ext.prefix = { "${meta.id}.mash" }
        publishDir = [
            path: { "${params.outdir}/mash" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: 'GAMBITCORE' {
        publishDir = [
            path: { "${params.outdir}/gambitcore" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'BWA_INDEX' {
        publishDir = [ enabled: false ]
    }

    withName: 'BWA_MEM' {
        ext.args   = '-M'
        publishDir = [ enabled: false ]
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args   = '-x lr:hq'
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_COVERAGE' {
        ext.prefix = { "${meta.id}.coverage" }
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: 'MLST' {
        ext.prefix = { "${meta.id}.mlst" }
        publishDir = [
            path: { "${params.outdir}/mlst" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    //
    // Species check
    //
    withName: 'KRAKEN2_KRAKEN2' {
        ext.args   = '--memory-mapping'
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: 'BRACKEN_BRACKEN' {
        ext.args      = { "-r ${params.bracken_read_length} -l S" }
        ext.prefix    = { "${meta.id}.bracken" }
        errorStrategy = 'ignore'
        publishDir    = [
            path: { "${params.outdir}/bracken" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    //
    // Allele calling and summaries
    //
    withName: 'CHEWBBACA_ALLELECALL' {
        // Same image as PrepExternalSchema in containers/Makefile, so Apptainer reuses it
        container  = { workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container ?
            'https://depot.galaxyproject.org/singularity/chewbbaca:3.5.4--pyh106432d_0' :
            'quay.io/biocontainers/chewbbaca:3.5.4--pyh106432d_0' }
        ext.args   = '--no-inferred'
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/chewbbaca/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Variant calling
    //
    withName: 'SNIPPY_RUN' {
        ext.args   = { "--mincov ${params.snp_min_depth}" }
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*/*.{vcf.gz,vcf.gz.csi}',
            saveAs: { filename -> filename.tokenize('/')[-1] }
        ]
    }

    withName: 'MINIMAP2_REFERENCE' {
        ext.args   = '-x lr:hq'
        ext.prefix = { "${meta.id}.reference" }
        publishDir = [ enabled: false ]
    }

    withName: 'CLAIR3' {
        ext.args   = '--include_all_ctgs --haploid_precise --no_phasing_for_fa'
        ext.prefix = { "${meta.id}." }
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*.merge_output.vcf.gz{,.tbi}',
            saveAs: { filename -> filename.replace('.merge_output', '') }
        ]
    }

    withName: 'GAWK_REFERENCE_CHROMOSOME' {
        ext.prefix = { "${meta.id}.chromosome" }
        publishDir = [ enabled: false ]
    }

    withName: 'NUCMER' {
        ext.args   = '--maxmatch --nosimplify'
        ext.prefix = { "${meta.id}.self" }
        publishDir = [ enabled: false ]
    }

    withName: 'PHISPY' {
        ext.prefix = { "${meta.id}.phispy" }
        publishDir = [
            path: { "${params.outdir}/snp_distances/masks" },
            mode: params.publish_dir_mode,
            pattern: '*.phispy.tsv'
        ]
    }

    withName: 'GAWK_REFERENCE_MASK' {
        ext.prefix = { "${meta.id}.mask" }
        publishDir = [
            path: { "${params.outdir}/snp_distances/masks" },
            mode: params.publish_dir_mode,
            pattern: '*.mask.bed'
        ]
    }

    withName: 'MOSDEPTH' {
        ext.args   = { "--quantize 0:${params.snp_min_depth}: --no-per-base --mapq 20" }
        publishDir = [ enabled: false ]
    }

    withName: 'GAWK_SAMPLE_MASK' {
        ext.prefix = { "${meta.id}.mask" }
        publishDir = [ enabled: false ]
    }

    withName: 'BCFTOOLS_VIEW' {
        ext.args   = "--output-type z --write-index=tbi --apply-filters PASS,. --types snps,mnps --include 'GT=\"alt\"'"
        ext.prefix = { "${meta.id}.snps" }
        publishDir = [ enabled: false ]
    }

    withName: 'BCFTOOLS_CONSENSUS' {
        ext.prefix = { "${meta.id}.consensus" }
        publishDir = [ enabled: false ]
    }

    withName: 'GAWK_PSEUDOGENOME' {
        ext.args   = { "-v id=${meta.id}" }
        ext.prefix = { "${meta.id}.pseudogenome" }
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*.pseudogenome.fa'
        ]
    }

    withName: 'GAWK_ALIGNMENT' {
        ext.args   = { "-v ref=${meta.reference}.chromosome.fa" }
        publishDir = [
            path: { "${params.outdir}/snp_distances" },
            mode: params.publish_dir_mode,
            pattern: '*.aln'
        ]
    }

    withName: 'GUBBINS' {
        publishDir = [
            path: { "${params.outdir}/snp_distances/gubbins" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SNPDISTS' {
        ext.prefix = { "${meta.id}.${meta.recombination_filtered ? 'gubbins.' : ''}snp_dists" }
        publishDir = [
            path: { "${params.outdir}/snp_distances" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SUMMARISE_QC' {
        publishDir = [ enabled: false ]
    }

    withName: 'CHECK_DISTANCES' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRANSMISSION_REPORT' {
        ext.args   = { "--formats ${params.report_formats} --environment-types ${params.report_environment_types}" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: 'report/**'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}

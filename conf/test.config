/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Placeholder reads (two Illumina, one Nanopore) and a dummy schema folder that
    check the pipeline wiring. The reads are not real, so run it as a stub test
    from the repository root:

        nextflow run . -profile test,docker -stub --outdir results
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Stub test with placeholder inputs'

    input       = "${projectDir}/assets/test/samplesheet.csv"
    metadata    = "${projectDir}/assets/test/metadata.csv"
    schemas_dir = "${projectDir}/assets/test/schemas"
}

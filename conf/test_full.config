/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    There is no full-size test dataset yet, so this runs the placeholder inputs of
    the test profile with every optional step switched on. Like the test profile it
    only works as a stub run from the repository root:

        nextflow run . -profile test_full,docker -stub --outdir results

    nf-core pipelines download also loads it to list every container the pipeline
    can use.
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Stub test with placeholder inputs and every optional step'

    trim      = true
    filtlong  = true
    gambit_db = "${projectDir}/assets/test/dbs/gambit"
}

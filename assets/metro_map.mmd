%%metro title: sinklink (Illumina / Nanopore)
%%metro style: nfcore
%%metro file: reads_in | FASTQ
%%metro file: readqc_out | HTML
%%metro file: assembly_fa | FASTA
%%metro file: qc_out | TSV
%%metro file: distances_tsv | TSV
%%metro file: report_out | HTML
%%metro line: readqc | Read QC | #8d99ae
%%metro line: species | Species check | #e63946 | dashed
%%metro line: qc | Assembly QC | #d99a00
%%metro line: typing | Assembly and typing | #2db572
%%metro line: variants | Variant calling and SNP distances | #7b5ea7
%%metro marker: filtering | square, open
%%metro marker: gambitcore | square, open
%%metro marker: gubbins | square, open
%%metro marker_legend: square, open | Optional step
%%metro legend: bl
%%metro y_spacing: 90

graph LR
    %% Read preparation
    reads_in[ ]
    deacon[Deacon]
    filtering[Trimmomatic / Filtlong]
    readqc[FastQC / NanoPlot]
    readqc_out[ ]

    reads_in -->|readqc,species,qc,typing,variants| deacon
    deacon -->|readqc,species,qc,typing,variants| filtering
    filtering -->|readqc| readqc
    readqc -->|readqc| readqc_out

    %% Species check
    kraken2[Kraken2]
    bracken[Bracken]

    filtering -->|species| kraken2
    kraken2 -->|species| bracken

    %% Assembly
    assembler[SKESA / Flye + Medaka]
    assembly_fa[ ]

    filtering -->|qc,typing| assembler
    assembler -->|qc,typing| assembly_fa

    %% Assembly QC
    quast[QUAST]
    mash[Mash]
    gambitcore[gambitcore]
    mlst[mlst]
    mapping[BWA-MEM / minimap2]
    coverage[SAMtools coverage]
    qc_summary[QC summary]
    qc_out[ ]

    assembly_fa -->|qc| quast
    quast -->|qc| mash
    mash -->|qc| gambitcore
    gambitcore -->|qc| mlst
    mlst -->|qc| mapping
    mapping -->|qc| coverage
    coverage -->|qc| qc_summary
    bracken -->|species| qc_summary
    qc_summary -->|species,qc| qc_out

    %% Typing and transmission check
    chewbbaca[chewBBACA]
    distances[Pairwise distances]
    distances_tsv[ ]
    report[Transmission report]
    report_out[ ]

    assembly_fa -->|typing| chewbbaca
    chewbbaca -->|typing| distances
    distances -->|typing,variants| distances_tsv
    distances_tsv -->|typing,variants| report
    report -->|typing,variants| report_out

    %% Variant calling and SNP distances
    caller[Snippy / minimap2 + Clair3]
    mosdepth[mosdepth]
    masks[MUMmer + PhiSpy]
    consensus[BCFtools consensus]
    gubbins[Gubbins]
    snpdists[snp-dists]

    filtering -->|variants| caller
    caller -->|variants| mosdepth
    mosdepth -->|variants| masks
    masks -->|variants| consensus
    consensus -->|variants| gubbins
    gubbins -->|variants| snpdists
    snpdists -->|variants| distances

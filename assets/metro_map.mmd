%%metro title: sinklink
%%metro style: nfcore
%%metro file: reads_in | FASTQ
%%metro file: distances_out | TSV
%%metro file: report_out | HTML
%%metro line: species | Species check (--kraken_db) | #e63946 | dashed
%%metro line: illumina | Illumina: SKESA | #2db572
%%metro line: nanopore | Nanopore: Flye + Medaka | #f5a623
%%metro marker: trimmomatic | square, open
%%metro marker: filtlong | square, open
%%metro marker: gambitcore | square, open
%%metro marker_legend: square, open | Optional step
%%metro legend: bl

graph LR
    %% Read preparation
    reads_in[ ]
    fastqc[FastQC]
    trimmomatic[Trimmomatic]
    nanoplot[NanoPlot]
    filtlong[Filtlong]

    reads_in -->|illumina| fastqc
    fastqc -->|illumina| trimmomatic
    reads_in -->|nanopore| nanoplot
    nanoplot -->|nanopore| filtlong

    %% Species check
    kraken2[Kraken2]
    bracken[Bracken]

    kraken2 -->|species| bracken

    %% Assembly
    skesa[SKESA]
    flye[Flye]
    medaka[Medaka]

    flye -->|nanopore| medaka

    %% Assembly QC
    quast[QUAST]
    gambitcore[gambitcore]
    bwa[BWA-MEM]
    minimap2[minimap2]
    coverage[SAMtools coverage]
    mlst[mlst]
    qc_summary[QC summary]

    quast -->|illumina,nanopore| gambitcore
    gambitcore -->|illumina| bwa
    gambitcore -->|nanopore| minimap2
    bwa -->|illumina| coverage
    minimap2 -->|nanopore| coverage
    coverage -->|illumina,nanopore| mlst
    mlst -->|illumina,nanopore| qc_summary

    %% Allele calling and transmission check
    chewbbaca[chewBBACA]
    distances[Pairwise distances]
    distances_out[ ]
    multiqc[MultiQC]
    report_out[ ]

    chewbbaca -->|illumina,nanopore| distances
    distances -->|illumina,nanopore| distances_out
    distances -->|illumina,nanopore| multiqc
    multiqc -->|illumina,nanopore| report_out

    %% Between groups
    reads_in -->|species| kraken2
    trimmomatic -->|illumina| skesa
    filtlong -->|nanopore| flye
    skesa -->|illumina| quast
    medaka -->|nanopore| quast
    bracken -->|species| qc_summary
    qc_summary -->|illumina,nanopore| chewbbaca
